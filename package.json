{
  "name": "agent-eval-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "demo": "tsx src/demo.ts",
    "check-leaks": "node scripts/check-leaks.mjs",
    "verify-fixtures": "node scripts/verify-fixtures.mjs",
    "record": "tsx --env-file-if-exists=.env.local scripts/record-openai.ts",
    "sweep": "tsx --env-file-if-exists=.env.local src/cli.ts",
    "report": "tsx src/report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@google/genai": "^2.17.1",
    "better-sqlite3": "^12.2.0",
    "openai": "^6.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
